{
  "name": "nestjs-docs-mcp",
  "version": "0.0.1",
  "description": "A local stdio and HTTP MCP server for NestJS v11 and v12 documentation.",
  "type": "module",
  "bin": {
    "nestjs-docs-mcp": "./dist/stdio.js",
    "nestjs-docs-mcp-http": "./dist/main.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaself/nestjs-docs-mcp.git"
  },
  "homepage": "https://github.com/rafaself/nestjs-docs-mcp#readme",
  "bugs": {
    "url": "https://github.com/rafaself/nestjs-docs-mcp/issues"
  },
  "keywords": [
    "nestjs",
    "mcp",
    "model-context-protocol",
    "documentation",
    "stdio",
    "streamable-http"
  ],
  "files": [
    "dist/**",
    "data/documentation-v11.sqlite",
    "data/documentation-v12.sqlite",
    "data/manifest.json",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses/nestjs-docs-v11-LICENSE",
    "licenses/nestjs-docs-v12-LICENSE"
  ],
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nest build",
    "prepack": "npm run build && node scripts/verify-package.mjs && node scripts/verify-packed-package.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:stdio": "node dist/stdio.js",
    "docs:ingest": "npm run build && node dist/ingestion/cli.js",
    "search:index": "npm run build && node dist/search/indexing/index.cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "search:evaluate": "npm run build && node scripts/evaluate-search.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/mcp": "^0.0.4",
    "@nestjs/platform-express": "^12.5.0",
    "json5": "^2.2.3",
    "marked": "^18.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.4.0",
    "@nestjs/cli": "^12.0.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}

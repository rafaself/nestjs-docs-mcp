{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node", "jest"],
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "@nestjs-docs/documentation-engine/*": [
        "./packages/documentation-engine/src/modules/documentation/*"
      ],
      "@nestjs-docs/docs-indexer/*": ["./apps/docs-indexer/src/*"]
    },
    "sourceMap": true,
    "removeComments": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "apps/docs-indexer/src/**/*.ts",
    "packages/documentation-engine/src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
